namespace bio;

// NCBI genetic codes: https://www.ncbi.nlm.nih.gov/Taxonomy/Utils/wprintgc.cgi
// Generated from Bio.Data.CodonTable, Biopython 1.88 (2026-10-31).
// Order: TCAG at each position; forward assignments win dual stops.
struct GeneticCode { id: i64, amino: u8[], starts: u8[], stops: u8[], dual: bool }
