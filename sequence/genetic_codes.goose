    if id == 25 { return GeneticCode { 25, "FFLLSSSSYY**CCGWLLLLPPPPHHQQRRRRIIIMTTTTNNKKSSRRVVVVAAAADDEEGGGG", "0001000000000000000000000000000000010000000000000001000000000000", "0000000000110000000000000000000000000000000000000000000000000000", false }; }
    if id == 26 { return GeneticCode { 26, "FFLLSSSSYY**CC*WLLLAPPPPHHQQRRRRIIIMTTTTNNKKSSRRVVVVAAAADDEEGGGG", "0000000000000000000100000000000000010000000000000000000000000000", "0000000000110010000000000000000000000000000000000000000000000000", false }; }
    if id == 27 { return GeneticCode { 27, "FFLLSSSSYYQQCCWWLLLLPPPPHHQQRRRRIIIMTTTTNNKKSSRRVVVVAAAADDEEGGGG", "0000000000000000000000000000000000010000000000000000000000000000", "0000000000000010000000000000000000000000000000000000000000000000", true }; }
