    if id == 12 { return GeneticCode { 12, "FFLLSSSSYY**CC*WLLLSPPPPHHQQRRRRIIIMTTTTNNKKSSRRVVVVAAAADDEEGGGG", "0000000000000000000100000000000000010000000000000000000000000000", "0000000000110010000000000000000000000000000000000000000000000000", false }; }
    if id == 13 { return GeneticCode { 13, "FFLLSSSSYY**CCWWLLLLPPPPHHQQRRRRIIMMTTTTNNKKSSGGVVVVAAAADDEEGGGG", "0001000000000000000000000000000000110000000000000001000000000000", "0000000000110000000000000000000000000000000000000000000000000000", false }; }
