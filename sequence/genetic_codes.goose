    if id == 16 { return GeneticCode { 16, "FFLLSSSSYY*LCC*WLLLLPPPPHHQQRRRRIIIMTTTTNNKKSSRRVVVVAAAADDEEGGGG", "0000000000000000000000000000000000010000000000000000000000000000", "0000000000100010000000000000000000000000000000000000000000000000", false }; }
    if id == 21 { return GeneticCode { 21, "FFLLSSSSYY**CCWWLLLLPPPPHHQQRRRRIIMMTTTTNNNKSSSSVVVVAAAADDEEGGGG", "0000000000000000000000000000000000010000000000000001000000000000", "0000000000110000000000000000000000000000000000000000000000000000", false }; }
    if id == 22 { return GeneticCode { 22, "FFLLSS*SYY*LCC*WLLLLPPPPHHQQRRRRIIIMTTTTNNKKSSRRVVVVAAAADDEEGGGG", "0000000000000000000000000000000000010000000000000000000000000000", "0000001000100010000000000000000000000000000000000000000000000000", false }; }
