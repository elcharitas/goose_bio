import hts from "..";
import bio from "..";

import bio.hts;
fn text(h: i64) -> u8[..] { var out: u8[>..] = []; assert(bio::hts_text(h, out) == 0); return out[..]; }
fn quality_roundtrip(mode: u8[..], q: u8[..], edit: bool) {
    let header = "@SQ\tSN:chr1\tLN:100\n";
    let w = bio::hts_open(".tools/quality-input.sam", "w", false, header, "");
    assert(bio::hts_write(w, "q\t0\tchr1\t1\t60\t2M\t*\t0\t0\tAC\t5~") == 0);
    assert(bio::hts_close(w) == 0);
    let r = bio::hts_open(".tools/quality-input.sam", "r", false, "", "");
    assert(bio::hts_next(r) == 1);
    let cigar: u32[1] = [32];
    if (edit) { assert(bio::bam_edit(r, cigar, "AC", q) == 0); }
    else { assert(bio::bam_set_quality(r, q) == 0); }
    let before = text(r);
    let first: u8[2] = [255, 20]; let last: u8[2] = [20, 255];
    if (edit) {
        assert(bio::bam_edit(r, cigar, "GT", first) == -1);
        assert(text(r) == before);
        assert(bio::bam_edit(r, cigar, "GT", last) == -1);
    } else {
        assert(bio::bam_set_quality(r, first) == -1);
        assert(text(r) == before);
        assert(bio::bam_set_quality(r, last) == -1);
    }
    assert(text(r) == before);
    let out = bio::hts_open(".tools/quality-output", mode, false, header, "");
    assert(bio::hts_copy_record(r, out) == 0);
    assert(bio::hts_close(out) == 0 && bio::hts_close(r) == 0);
    let reopened = bio::hts_open(".tools/quality-output", "r", false, "", "");
    assert(bio::hts_next(reopened) == 1 && text(reopened) == before);
    var actual: u8[>..] = [];
    assert(bio::bam_quality(reopened, actual) == 0 && actual[..] == q);
    assert(bio::hts_next(reopened) == 0 && bio::hts_close(reopened) == 0);
}
fn main() {
    let missing: u8[2] = [255, 255]; let present: u8[2] = [0, 93];
    quality_roundtrip("w", missing, true);
    quality_roundtrip("wb", missing, true);
    quality_roundtrip("w", present, true);
    quality_roundtrip("wb", present, true);
    quality_roundtrip("w", missing, false);
    quality_roundtrip("wb", missing, false);
    quality_roundtrip("w", present, false);
    quality_roundtrip("wb", present, false);
    let pair_header = "##fileformat=VCFv4.3\n##contig=<ID=chr1,length=100>\n#CHROM\tPOS\tID\tREF\tALT\tQUAL\tFILTER\tINFO\n";
    let pair_writer = bio::hts_open(".tools/pair.bcf", "wb", true, pair_header, "");
    assert(bio::hts_write(pair_writer, "chr1\t1\t.\tA\tC\t.\tPASS\t.") == 0);
    assert(bio::hts_close(pair_writer) == 0);
    let pair = bio::hts_open(".tools/pair.bcf", "r", true, "", "");
    assert(bio::hts_next(pair) == 1);
    let pair_before = text(pair);
    assert(bio::bcf_set_alleles(pair, "A,A") == -1 && text(pair) == pair_before);
    assert(bio::bcf_set_alleles(pair, "a,A") == -1 && text(pair) == pair_before);
    assert(bio::bcf_set_alleles(pair, "ac,AC") == -1 && text(pair) == pair_before);
    assert(bio::bcf_set_alleles(pair, "a,ac") == 0);
    assert(bio::hts_close(pair) == 0);
    let header = "##fileformat=VCFv4.3\n##contig=<ID=chr1,length=100>\n##INFO=<ID=AF,Number=A,Type=Float,Description=\"Frequency\">\n##INFO=<ID=LABEL,Number=R,Type=String,Description=\"Labels\">\n##INFO=<ID=YES,Number=0,Type=Flag,Description=\"Flag\">\n##FORMAT=<ID=GT,Number=1,Type=String,Description=\"Genotype\">\n##FORMAT=<ID=FV,Number=.,Type=Float,Description=\"Values\">\n##FORMAT=<ID=ST,Number=1,Type=String,Description=\"String\">\n#CHROM\tPOS\tID\tREF\tALT\tQUAL\tFILTER\tINFO\tFORMAT\tb\ta\n";
    let w = bio::hts_open(".tools/edit.bcf", "wb", true, header, "");
    assert(w > 0);
    assert(bio::hts_write(w, "chr1\t1\t.\tA\tC,G\t.\tPASS\tAF=0.1,.;LABEL=ref,c,g\tGT:FV:ST\t1|2:1,2:old\t.:.:.") == 0);
    assert(bio::hts_close(w) == 0);
    let r = bio::hts_open(".tools/edit.bcf", "r", true, "", "");
    assert(bio::hts_next(r) == 1);
    let af: u32[2] = [1065353216, 2139095041];
    let fv: u32[6] = [1065353216, 2139095041, 1073741824, 2139095041, 2139095042, 2139095042];
    assert(bio::bcf_set_float_bits(r, "AF", false, af) == 0);
    assert(bio::bcf_set_float_bits(r, "FV", true, fv) == 0);
    assert(bio::bcf_set_string(r, "LABEL", false, "reference,cytosine,guanine") == 0);
    assert(bio::bcf_set_string(r, "ST", true, "second\t.") == 0);
    assert(bio::bcf_set_flag(r, "YES", true) == 0 && bio::bcf_flag(r, "YES") == 1);
    assert(bio::bcf_set_alleles(r, "T,C,A") == 0);
    let before = text(r);
    let bad:    u32[1] = [1065353216];
    let middle: u32[6] = [2139095042, 1065353216, 2139095042, 0, 0, 0];
    assert(bio::bcf_set_float_bits(r, "AF", false, bad) == -1);
    assert(bio::bcf_set_float_bits(r, "FV", true, middle) == -1);
    assert(bio::bcf_set_float_bits(r, "LABEL", false, af) == -1);
    assert(bio::bcf_set_string(r, "AF", false, "bad") == -1);
    assert(bio::bcf_set_string(r, "LABEL", false, "one,two") == -1);
    assert(bio::bcf_set_string(r, "ST", true, "one") == -1);
    assert(bio::bcf_set_string(r, "GT", true, "0/1\t0/0") == -1);
    assert(bio::bcf_set_flag(r, "AF", true) == -1);
    assert(bio::bcf_set_flag(r, "UNKNOWN", true) == -1);
    let wrong = bio::hts_open(".tools/wrong-header.bcf", "wb", true,
        "##fileformat=VCFv4.3\n##contig=<ID=chr1,length=100>\n#CHROM\tPOS\tID\tREF\tALT\tQUAL\tFILTER\tINFO\n", "");
    assert(bio::hts_copy_record(r, wrong) == -1);
    assert(bio::hts_close(wrong) == 0);
    assert(bio::bcf_set_alleles(r, "A,C") == -1);
    assert(bio::bcf_set_alleles(r, "A,,C") == -1);
    assert(bio::bcf_set_alleles(r, "A,C*,G") == -1);
    assert(bio::bcf_set_alleles(r, "A,A,G") == -1 && text(r) == before);
    assert(bio::bcf_set_alleles(r, "A,a,G") == -1 && text(r) == before);
    assert(bio::bcf_set_alleles(r, "A,C,c") == -1 && text(r) == before);
    assert(bio::bcf_set_alleles(r, "AC,G,ac") == -1 && text(r) == before);
    assert(bio::bcf_set_alleles(r, "A,*,*") == -1 && text(r) == before);
    assert(text(r) == before);
    let d = bio::hts_open(".tools/edit-out.bcf", "wb", true, header, "");
    assert(bio::hts_copy_record(r, d) == 0);
    assert(bio::hts_close(d) == 0 && bio::hts_close(r) == 0);
    let m = bio::hts_open(".tools/edit-out.bcf", "r", true, "", "");
    assert(bio::hts_next(m) == 1);
    assert(text(m) == before);
    assert(bio::bcf_float_count(m, "FV", true) == 6);
    assert(bio::bcf_float_bits(m, "FV", true, 1) == 2139095041);
    assert(bio::bcf_float_bits(m, "FV", true, 4) == 2139095042);
    assert(bio::bcf_float_bits(m, "AF", false, 1) == 2139095041);
    assert(bio::bcf_float_bits(m, "AF", false, 9) == -1);
    assert(bio::bcf_int(m, "GT", true, 0) == 4 && bio::bcf_int(m, "GT", true, 1) == 7);
    assert(bio::bcf_int(m, "GT", true, 3) == -2147483647);
    var st: u8[>..] = []; var label: u8[>..] = [];
    assert(bio::bcf_string(m, "ST", true, 0, st) == 0 && st[..] == "second");
    assert(bio::bcf_string(m, "LABEL", false, 0, label) == 0 && label[..] == "reference,cytosine,guanine");
    assert(bio::bcf_set_flag(m, "YES", false) == 0 && bio::bcf_flag(m, "YES") == 0);
    assert(bio::hts_close(m) == 0);
    let sh = "@SQ\tSN:chr1\tLN:100\n";
    let bw = bio::hts_open(".tools/edit.bam", "wb", false, sh, "");
    assert(bio::hts_write(bw, "r\t1\tchr1\t5\t60\t4M\t=\t20\t19\tACGT\tIIII\tZZ:Z:retain\tNM:i:1") == 0);
    assert(bio::hts_close(bw) == 0);
    let br = bio::hts_open(".tools/edit.bam", "r", false, "", "");
    assert(bio::hts_next(br) == 1);
    let cigar: u32[5] = [20, 32, 17, 18, 16];
    let q:     u8[5]  = [1, 2, 3, 4, 5];
    assert(bio::bam_edit(br, cigar, "AACGT", q) == 0);
    let bt = text(br);
    let mismatch: u32[1] = [16]; let span: u32[2] = [80, 16002];
    assert(bio::bam_edit(br, mismatch, "AACGT", q) == -1);
    let badclip: u32[3] = [32, 20, 32];
    assert(bio::bam_edit(br, badclip, "AACGT", q) == -1);
    assert(bio::bam_edit(br, span, "AACGT", q) == -1);
    assert(bio::bam_edit(br, cigar, "AACG!", q) == -1);
    assert(text(br) == bt);
    let bd = bio::hts_open(".tools/edit-out.bam", "wb", false, sh, "");
    assert(bio::hts_copy_record(br, bd) == 0);
    assert(bio::hts_close(bd) == 0 && bio::hts_close(br) == 0);
    let bm = bio::hts_open(".tools/edit-out.bam", "r", false, "", "");
    assert(bio::hts_next(bm) == 1 && text(bm) == bt);
    assert(bio::bam_aux_int(bm, "NM", 0) == 1);
    var zz: u8[>..] = [];
    assert(bio::bam_aux_string(bm, "ZZ", zz) == 0 && zz[..] == "retain");
    assert(bio::bam_cigar(bm, 0) == 20);
    var quality: u8[>..] = []; var sequence: u8[>..] = [];
    assert(bio::bam_quality(bm, quality) == 0 && quality[..] == q[..]);
    assert(bio::bam_sequence(bm, sequence) == 0 && sequence[..] == "AACGT");
    assert(bio::hts_close(bm) == 0);
    assert(bio::hts_index(".tools/edit-out.bam", false) == 0);
    let bi = bio::hts_open(".tools/edit-out.bam", "r", false, "", "");
    assert(bio::hts_query(bi, "chr1:8-8") == 0 && bio::hts_next(bi) == 1);
    assert(bio::hts_close(bi) == 0);
    let pw = bio::hts_open(".tools/filter.bam", "wb", false, sh, "");
    assert(bio::hts_write(pw, "a\t0\tchr1\t1\t60\t1M\t*\t0\t0\tA\tI") == 0);
    assert(bio::hts_write(pw, "b\t1024\tchr1\t1\t60\t1M\t*\t0\t0\tA\tI") == 0);
    assert(bio::hts_write(pw, "c\t0\tchr1\t1\t10\t1M\t*\t0\t0\tA\tI") == 0);
    assert(bio::hts_close(pw) == 0);
    let pr = bio::hts_open(".tools/filter.bam", "r", false, "", "");
    assert(bio::pileup_configure(pr, 100, 1024, 20) == 0);
    assert(bio::pileup_next(pr) == 1 && bio::pileup_field(pr, 0, 2) == 1);
    assert(bio::pileup_configure(pr, 100, 0, 0) == -1);
    assert(bio::pileup_next(pr) == 0 && bio::hts_close(pr) == 0);
    let pc = bio::hts_open(".tools/filter.bam", "r", false, "", "");
    assert(bio::pileup_configure(pc, 1, 0, 0) == 0);
    assert(bio::pileup_next(pc) == 1 && bio::pileup_field(pc, 0, 2) == 1);
    assert(bio::hts_close(pc) == 0);
}
