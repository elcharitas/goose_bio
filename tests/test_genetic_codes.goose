import bio from "..";
import bio.sequence.sequence;
fn main() {
    assert(bio::translate("GCNTARRAYSARWTA").value == "A*BZJ");
    assert(bio::translate("TAN").value == "X");
    assert(bio::translate_with_options("ATGA", bio::TranslationOptions { allow_partial: true }).value == "M");
    assert(bio::translate_with_options("AT", bio::TranslationOptions { allow_partial: true }).value == "");
    assert(bio::translate_with_options("ATGTAAATG", bio::TranslationOptions { to_stop: true }).value == "M");
    assert(bio::translate_with_options("ATG---TAA", bio::TranslationOptions { gap: '-' }).value == "M-*");
    assert(bio::translate_with_options("ATG-A-TAA", bio::TranslationOptions { gap: '-' }).error.len > 0);
    assert(bio::translate_with_options("ATGTAAATGTAA", bio::TranslationOptions { cds: true }).error.len > 0);
    assert(bio::translate_with_options("ATGAA", bio::TranslationOptions { cds: true, allow_partial: true }).error.len > 0);
