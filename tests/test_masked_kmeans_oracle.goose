        assert(abs(r.centroids[2] - 2.0) < 1e-10); assert(r.centroid_mask[2] == 1);
        assert(abs(r.centroids[3] - -3.0) < 1e-10); assert(r.centroid_mask[3] == 1);
        assert(abs(r.centroids[4] - 7.5) < 1e-10); assert(r.centroid_mask[4] == 1);
        assert(abs(r.centroids[5] - 8.0) < 1e-10); assert(r.centroid_mask[5] == 1);
    }
    {
        let r = bio::masked_kcluster([3.0, 7.0, -2.0], [0, 0, 1], 3, 1, [0.5], [0, 1, 0], 2, 'a', 'e', false, 10000, 100000000);
        assert(r.error.len == 0);
        assert(r.nfound == 1);
        assert(abs(r.objective - 0.0) < 1e-9);
        assert(abs(r.final_objective - 0.0) < 1e-9);
        assert(r.labels[0] == 0);
        assert(r.labels[1] == 1);
        assert(r.labels[2] == 0);
        assert(abs(r.centroids[0] - -2.0) < 1e-10); assert(r.centroid_mask[0] == 1);
        assert(abs(r.centroids[1] - 0.0) < 1e-10); assert(r.centroid_mask[1] == 0);
    }
    {
        let r = bio::masked_kcluster([3.0, 7.0, -2.0], [0, 0, 1], 1, 3, [0.5], [0, 1, 0], 2, 'a', 'e', true, 10000, 100000000);
        assert(r.error.len == 0);
        assert(r.nfound == 1);
        assert(abs(r.objective - 0.0) < 1e-9);
        assert(abs(r.final_objective - 0.0) < 1e-9);
        assert(r.labels[0] == 0);
        assert(r.labels[1] == 1);
        assert(r.labels[2] == 0);
        assert(abs(r.centroids[0] - -2.0) < 1e-10); assert(r.centroid_mask[0] == 1);
        assert(abs(r.centroids[1] - 0.0) < 1e-10); assert(r.centroid_mask[1] == 0);
    }
    {
        let r = bio::masked_kcluster([3.0, 7.0, -2.0], [0, 0, 1], 3, 1, [0.5], [0, 1, 0], 2, 'm', 'e', false, 10000, 100000000);
        assert(r.error.len == 0);
        assert(r.nfound == 1);
        assert(abs(r.objective - 0.0) < 1e-9);
        assert(abs(r.final_objective - 0.0) < 1e-9);
        assert(r.labels[0] == 0);
        assert(r.labels[1] == 1);
        assert(r.labels[2] == 0);
        assert(abs(r.centroids[0] - -2.0) < 1e-10); assert(r.centroid_mask[0] == 1);
        assert(abs(r.centroids[1] - 0.0) < 1e-10); assert(r.centroid_mask[1] == 0);
    }
    {
        let r = bio::masked_kcluster([3.0, 7.0, -2.0], [0, 0, 1], 1, 3, [0.5], [0, 1, 0], 2, 'm', 'e', true, 10000, 100000000);
        assert(r.error.len == 0);
        assert(r.nfound == 1);
        assert(abs(r.objective - 0.0) < 1e-9);
        assert(abs(r.final_objective - 0.0) < 1e-9);
        assert(r.labels[0] == 0);
        assert(r.labels[1] == 1);
        assert(r.labels[2] == 0);
        assert(abs(r.centroids[0] - -2.0) < 1e-10); assert(r.centroid_mask[0] == 1);
        assert(abs(r.centroids[1] - 0.0) < 1e-10); assert(r.centroid_mask[1] == 0);
    }
    print("masked kcluster: 148 actual Bio cases, both orientations passed"); }
