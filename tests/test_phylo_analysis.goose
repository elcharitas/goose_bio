import bio from "..";
import bio.phylo.tree_formats;
import math;
fn main() {
    let a = bio::parse_newick("((A:1,B:2)named:3,C:4)root:99;");
    let b = bio::parse_newick("(A:1,(C:2,B:3):4);");
    let c = bio::parse_newick("((B:2,A:1):3,C:4);");
    let reps:   const bio::TreeResult&[] = [a, b, c];
    let pair:   const bio::TreeResult&[] = [a, b];
    let single: const bio::TreeResult&[] = [a];
    let analysis = bio::tree_analysis(a);
    assert(analysis.error.len == 0 && analysis.labels.len == 3);
    assert(analysis.masks[2] == 3 && analysis.masks[4] == 7);
    let d = bio::tree_path_distances(a);
    assert(d.error.len == 0 && d.values[1] == 3 && d.values[2] == 8 && d.values[5] == 9);
    let s = bio::bootstrap_support(a, reps);
    assert(s.error.len == 0 && abs(s.percent[2] - 200.0 / 3) < 1e-10 && s.percent[4] == 100 && s.percent[0] == -1);
    let consensus = bio::rooted_majority_consensus(reps);
    assert(consensus.error.len == 0 && consensus.tree.nodes.len == 5);
    let ca = bio::tree_analysis(consensus.tree);
    assert(ca.error.len == 0);
    let tied = bio::rooted_majority_consensus(pair);
    assert(tied.error.len == 0 && tied.tree.nodes.len == 4);
    let strict = bio::rooted_majority_consensus(reps, 1);
    assert(strict.error.len == 0 && strict.tree.nodes.len == 4);
    assert(bio::rooted_majority_consensus(single, 0.49).error.len > 0);
    assert(bio::rooted_majority_consensus(single, log(-1.0)).error.len > 0);
    assert(bio::rooted_majority_consensus([]).error.len > 0);
    let no = bio::parse_newick("(A,B,C);");
    assert(bio::tree_path_distances(no).error.len > 0);
    assert(bio::tree_path_distances(no, true).values[1] == 0);
    let duplicate = bio::parse_newick("(A,A);");
    assert(bio::tree_analysis(duplicate).error.len > 0);
    let unary = bio::parse_newick("((A),B);");
    assert(bio::tree_analysis(unary).error.len > 0);
    let wrong = bio::parse_newick("(A,B,D);");
    let wrongs: const bio::TreeResult&[] = [wrong];
    let mixed:  const bio::TreeResult&[] = [a, wrong];
    assert(bio::bootstrap_support(a, wrongs).error.len > 0);
    assert(bio::rooted_majority_consensus(mixed).error.len > 0);
    let nx = bio::serialize_nexus_tree(a);
    let restored = bio::parse_nexus_tree(nx.text);
    assert(restored.error.len == 0 && bio::serialize_newick(restored).text == bio::serialize_newick(a).text);
    assert(bio::parse_nexus_tree("#NEXUS\nBEGIN TREES;\nTREE tree = [&R](A,B);\nEND;\n").error.len > 0);
    let leaf = bio::parse_newick("A:2;");
    let leaves: const bio::TreeResult&[] = [leaf];
    assert(bio::rooted_majority_consensus(leaves).tree.nodes.len == 1);
    let all: const bio::TreeResult&[] = [a, c];
    assert(bio::rooted_majority_consensus(all, 1).tree.nodes.len == 5);
    assert(bio::rooted_majority_consensus(all, 2).error.len > 0);
    assert(bio::bootstrap_support(a, []).error.len > 0);
    let invalid = bio::TreeResult { [bio::TreeNode { "A", [0], 0, false }], 0, "" };
    assert(bio::tree_analysis(invalid).error.len > 0);
    let nxunsupported = bio::parse_nexus_tree("#NEXUS\nBEGIN TREES;\nTREE tree = (A,B); TREE second = (A,B);\nEND;\n");
    assert(nxunsupported.error.len > 0);
    print("phylo analysis: passed");
}
