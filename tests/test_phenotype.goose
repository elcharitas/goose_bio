assert(abs(subtract.times[4]-(6.0)) < 1e-10);
assert(is_nan(subtract.signals[4]));
let wells = [copy(b),copy(w0)]; let p = bio::phenotype_plate("PM01",wells); assert(p.error.len == 0);
let selected: u8[][] = ["B01"]; let r = bio::phenotype_subtract_control(p,"A01",selected,false); assert(r.error.len == 0 && r.id == "PM01");
{ var found = false; for w in r.wells { if w.id == "A01" { found = true;
assert(abs(w.times[0]-(0.0)) < 1e-10);
assert(abs(w.signals[0]-(1.0)) < 1e-10);
assert(abs(w.times[1]-(1.0)) < 1e-10);
assert(abs(w.signals[1]-(5.0)) < 1e-10);
assert(abs(w.times[2]-(4.0)) < 1e-10);
assert(abs(w.signals[2]-(9.0)) < 1e-10);
} } assert(found); }
{ var found = false; for w in r.wells { if w.id == "B01" { found = true;
assert(abs(w.times[0]-(0.0)) < 1e-10);
