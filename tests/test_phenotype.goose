let subtract = bio::phenotype_subtract(w0,b); assert(subtract.id == "A01");
assert(subtract.times.len == 5);
assert(abs(subtract.times[0]-(0.0)) < 1e-10);
assert(is_nan(subtract.signals[0]));
assert(abs(subtract.times[1]-(1.0)) < 1e-10);
