let b = bio::phenotype_well("B01",[1.0,3.0,6.0],[10.0,20.0,30.0]);
assert(b.error.len == 0);
assert(abs(b.times[0]-(1.0)) < 1e-10);
assert(abs(b.signals[0]-(10.0)) < 1e-10);
assert(abs(b.times[1]-(3.0)) < 1e-10);
assert(abs(b.signals[1]-(20.0)) < 1e-10);
