assert(abs(w.times[3]-(4.0)) < 1e-10);
assert(abs(w.signals[3]-(14.333333333333332)) < 1e-10);
assert(abs(w.times[4]-(6.0)) < 1e-10);
assert(is_nan(w.signals[4]));
} } assert(found); }
let none: u8[][] = []; assert(bio::phenotype_subtract_control(p,"missing",none,true).error.len > 0);
let bad: u8[][] = ["absent"]; assert(bio::phenotype_subtract_control(p,"A01",bad,false).error.len > 0);
assert(bio::phenotype_well("bad",[0.0],[]).error.len > 0);
assert(bio::phenotype_well("bad",[log(-1.0)],[1.0]).error.len > 0);
let empty = bio::phenotype_well("empty",[],[]); assert(bio::phenotype_summary(empty).error.len > 0); assert(is_nan(bio::phenotype_interpolate(empty,0)));
let all = bio::phenotype_subtract_control(p,"A01",none,true); for w in all.wells { if w.id == "A01" { for y in w.signals { assert(y == 0); } } }
for w in p.wells { if w.id == "A01" { assert(w.signals[0] == 1 && w.signals[1] == 5); } }
{
let ra = bio::phenotype_well("X",[7.0,5.0],[19.81537647805159,-37.529761727673616]);
assert(ra.error.len == 0);
assert(abs(ra.times[0]-(5.0)) < 1e-10);
assert(abs(ra.signals[0]-(-37.529761727673616)) < 1e-10);
assert(abs(ra.times[1]-(7.0)) < 1e-10);
assert(abs(ra.signals[1]-(19.81537647805159)) < 1e-10);
