assert(abs(s4.minimum-(2.0)) < 1e-10);
assert(abs(s4.maximum-(3.0)) < 1e-10);
assert(is_nan(s4.average_height));
assert(is_nan(bio::phenotype_trapezoidal_area(w4).value));
