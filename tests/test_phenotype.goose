let duplicates = [copy(b),copy(w0),copy(w1),copy(w0)]; let ordered = bio::phenotype_plate("P",duplicates); assert(ordered.wells.len == 3); var k = 0; for w in ordered.wells { if k == 0 { assert(w.id == "A01"); } if k == 1 { assert(w.id == "A02"); } if k == 2 { assert(w.id == "B01"); } k += 1; }
let replacement = bio::phenotype_well("A01",[0.0],[99.0]); let repeated = [copy(w0),copy(replacement)]; let replaced = bio::phenotype_plate("P",repeated); assert(replaced.wells.len == 1); for w in replaced.wells { assert(w.signals.len == 1 && w.signals[0] == 99); }
let unchanged = bio::phenotype_subtract_control(p,"A01",none,false); for w in unchanged.wells { if w.id == "B01" { assert(w.signals[0] == 10); } }
print("phenotype oracle passed"); }
