assert(abs(bio::phenotype_interpolate(w3,3)-(2.3333333333333335)) < 1e-10);
assert(abs(bio::phenotype_interpolate(w3,4)-(2.0)) < 1e-10);
assert(is_nan(bio::phenotype_interpolate(w3,5)));
assert(is_nan(bio::phenotype_interpolate(w3,6)));
assert(is_nan(bio::phenotype_interpolate(w3,9)));
let s3 = bio::phenotype_summary(w3); assert(s3.error.len == 0);
assert(is_nan(s3.minimum));
assert(is_nan(s3.maximum));
assert(is_nan(s3.average_height));
assert(is_nan(bio::phenotype_trapezoidal_area(w3).value));
let w4 = bio::phenotype_well("A05",[0.0,1.0,4.0],[3.0,log(-1.0),2.0]);
assert(w4.error.len == 0);
assert(abs(w4.times[0]-(0.0)) < 1e-10);
