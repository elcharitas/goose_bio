assert(abs(w3.times[1]-(1.0)) < 1e-10);
assert(abs(w3.signals[1]-(3.0)) < 1e-10);
assert(abs(w3.times[2]-(4.0)) < 1e-10);
assert(abs(w3.signals[2]-(2.0)) < 1e-10);
assert(is_nan(bio::phenotype_interpolate(w3,-1)));
