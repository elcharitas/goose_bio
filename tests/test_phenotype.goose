import bio from "..";
import bio.analysis.phenotype;
import math;
fn main() {
let w0 = bio::phenotype_well("A01",[4.0,0.0,1.0,1.0],[9.0,1.0,3.0,5.0]);
assert(w0.error.len == 0);
assert(abs(w0.times[0]-(0.0)) < 1e-10);
assert(abs(w0.signals[0]-(1.0)) < 1e-10);
assert(abs(w0.times[1]-(1.0)) < 1e-10);
assert(abs(w0.signals[1]-(5.0)) < 1e-10);
assert(abs(w0.times[2]-(4.0)) < 1e-10);
assert(abs(w0.signals[2]-(9.0)) < 1e-10);
assert(is_nan(bio::phenotype_interpolate(w0,-1)));
assert(abs(bio::phenotype_interpolate(w0,0)-(1.0)) < 1e-10);
assert(abs(bio::phenotype_interpolate(w0,0.5)-(3.0)) < 1e-10);
assert(abs(bio::phenotype_interpolate(w0,1)-(5.0)) < 1e-10);
assert(abs(bio::phenotype_interpolate(w0,2)-(6.333333333333333)) < 1e-10);
assert(abs(bio::phenotype_interpolate(w0,3)-(7.666666666666666)) < 1e-10);
assert(abs(bio::phenotype_interpolate(w0,4)-(9.0)) < 1e-10);
assert(is_nan(bio::phenotype_interpolate(w0,5)));
assert(is_nan(bio::phenotype_interpolate(w0,6)));
assert(is_nan(bio::phenotype_interpolate(w0,9)));
let s0 = bio::phenotype_summary(w0); assert(s0.error.len == 0);
assert(abs(s0.minimum-(1.0)) < 1e-10);
assert(abs(s0.maximum-(9.0)) < 1e-10);
assert(abs(s0.average_height-(5.0)) < 1e-10);
assert(abs(bio::phenotype_trapezoidal_area(w0).value-(24.0)) < 1e-10);
let w1 = bio::phenotype_well("A02",[2.0],[7.0]);
assert(w1.error.len == 0);
assert(abs(w1.times[0]-(2.0)) < 1e-10);
assert(abs(w1.signals[0]-(7.0)) < 1e-10);
assert(is_nan(bio::phenotype_interpolate(w1,-1)));
assert(is_nan(bio::phenotype_interpolate(w1,0)));
assert(is_nan(bio::phenotype_interpolate(w1,0.5)));
assert(is_nan(bio::phenotype_interpolate(w1,1)));
assert(abs(bio::phenotype_interpolate(w1,2)-(7.0)) < 1e-10);
