assert(is_nan(bio::phenotype_interpolate(w1,4)));
assert(is_nan(bio::phenotype_interpolate(w1,5)));
assert(is_nan(bio::phenotype_interpolate(w1,6)));
assert(is_nan(bio::phenotype_interpolate(w1,9)));
let s1 = bio::phenotype_summary(w1); assert(s1.error.len == 0);
assert(abs(s1.minimum-(7.0)) < 1e-10);
assert(abs(s1.maximum-(7.0)) < 1e-10);
assert(abs(s1.average_height-(7.0)) < 1e-10);
assert(abs(bio::phenotype_trapezoidal_area(w1).value-(0.0)) < 1e-10);
let w2 = bio::phenotype_well("A03",[0.0,2.0,5.0],[0.0,8.0,-2.0]);
assert(w2.error.len == 0);
assert(abs(w2.times[0]-(0.0)) < 1e-10);
assert(abs(w2.signals[0]-(0.0)) < 1e-10);
assert(abs(w2.times[1]-(2.0)) < 1e-10);
assert(abs(w2.signals[1]-(8.0)) < 1e-10);
assert(abs(w2.times[2]-(5.0)) < 1e-10);
assert(abs(w2.signals[2]-(-2.0)) < 1e-10);
assert(is_nan(bio::phenotype_interpolate(w2,-1)));
assert(abs(bio::phenotype_interpolate(w2,0)-(0.0)) < 1e-10);
assert(abs(bio::phenotype_interpolate(w2,0.5)-(2.0)) < 1e-10);
assert(abs(bio::phenotype_interpolate(w2,1)-(4.0)) < 1e-10);
assert(abs(bio::phenotype_interpolate(w2,2)-(8.0)) < 1e-10);
assert(abs(bio::phenotype_interpolate(w2,3)-(4.666666666666666)) < 1e-10);
assert(abs(bio::phenotype_interpolate(w2,4)-(1.333333333333333)) < 1e-10);
assert(abs(bio::phenotype_interpolate(w2,5)-(-2.0)) < 1e-10);
assert(is_nan(bio::phenotype_interpolate(w2,6)));
assert(is_nan(bio::phenotype_interpolate(w2,9)));
let s2 = bio::phenotype_summary(w2); assert(s2.error.len == 0);
assert(abs(s2.minimum-(-2.0)) < 1e-10);
assert(abs(s2.maximum-(8.0)) < 1e-10);
assert(abs(s2.average_height-(2.0)) < 1e-10);
