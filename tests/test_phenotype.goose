assert(abs(bio::phenotype_interpolate(b,6)-(30.0)) < 1e-10);
assert(is_nan(bio::phenotype_interpolate(b,9)));
let add = bio::phenotype_add(w0,b); assert(add.id == "A01");
assert(add.times.len == 5);
