import hts from "..";
import bio from "..";
import bio.hts;
import os;
fn text(h: i64) -> u8[..] { var out: u8[>..] = []; assert(bio::hts_text(h, out) == 0); return out[..]; }
fn rejected(header: u8[..], record: u8[..]) {
    let w = bio::hts_open(".tools/mapping-invalid.bcf", "wb", true, header, "");
    assert(bio::hts_write(w, record) == 0);
    assert(bio::hts_close(w) == 0);
    let r = bio::hts_open(".tools/mapping-invalid.bcf", "r", true, "", "");
    assert(bio::hts_next(r) == 1);
    let before = text(r);
    let out = bio::hts_open(".tools/mapping-preserve.bcf", "wb", true, header, "");
    assert(bio::hts_write(out, record) == 0);
    let previous = text(out);
    assert(bio::hts_copy_variant_mapped(r, out) == -1);
    assert(text(r) == before && text(out) == previous);
    assert(bio::hts_close(out) == 0 && bio::hts_close(r) == 0);
}
fn main() {
    let parse_header = "##fileformat=VCFv4.3\n##contig=<ID=chr1,length=100>\n#CHROM\tPOS\tID\tREF\tALT\tQUAL\tFILTER\tINFO\n";
    let mapped_header = "##fileformat=VCFv4.3\n##contig=<ID=chr1,length=100>\n##INFO=<ID=X,Number=1,Type=String,Description=\"x\">\n#CHROM\tPOS\tID\tREF\tALT\tQUAL\tFILTER\tINFO\n";
    assert(write_file(".tools/mapping-parse-error.vcf", str(parse_header,
        "chr1\t1\t.\tA\tC\t.\tPASS\tX=abc\n")));
    let parse_source = bio::hts_open(".tools/mapping-parse-error.vcf", "r", true, "", "");
    assert(parse_source > 0 && bio::hts_next(parse_source) == 1);
    let parse_before = text(parse_source);
    let parse_destination = bio::hts_open(".tools/mapping-error-output.bcf", "wb", true, mapped_header, "");
    assert(parse_destination > 0);
    assert(bio::hts_write(parse_destination, "chr1\t2\t.\tA\tC\t.\tPASS\tX=old") == 0);
    let destination_before = text(parse_destination);
    assert(bio::hts_copy_variant_mapped(parse_source, parse_destination) == -1);
    assert(text(parse_source) == parse_before && text(parse_destination) == destination_before);
    assert(bio::hts_close(parse_source) == 0 && bio::hts_close(parse_destination) == 0);
    let parse_output = bio::hts_open(".tools/mapping-error-output.bcf", "r", true, "", "");
    assert(bio::hts_next(parse_output) == 1 && text(parse_output) == destination_before);
    assert(bio::hts_next(parse_output) == 0 && bio::hts_close(parse_output) == 0);

    let src = "##fileformat=VCFv4.3\n##contig=<ID=chr1,length=100>\n##contig=<ID=chr2,length=100>\n##INFO=<ID=IX,Number=R,Type=Integer,Description=\"x\">\n##INFO=<ID=FX,Number=A,Type=Float,Description=\"x\">\n##FORMAT=<ID=GT,Number=1,Type=String,Description=\"x\">\n##FORMAT=<ID=VI,Number=.,Type=Integer,Description=\"x\">\n##FORMAT=<ID=VF,Number=.,Type=Float,Description=\"x\">\n##FORMAT=<ID=ST,Number=1,Type=String,Description=\"x\">\n#CHROM\tPOS\tID\tREF\tALT\tQUAL\tFILTER\tINFO\tFORMAT\ta\tb\tc\n";
    let dst = "##fileformat=VCFv4.3\n##contig=<ID=chr2,length=100>\n##contig=<ID=chr1,length=100>\n##FORMAT=<ID=ST,Number=1,Type=String,Description=\"x\">\n##FORMAT=<ID=VF,Number=.,Type=Float,Description=\"x\">\n##FORMAT=<ID=VI,Number=.,Type=Integer,Description=\"x\">\n##FORMAT=<ID=GT,Number=1,Type=String,Description=\"x\">\n##INFO=<ID=FX,Number=A,Type=Float,Description=\"x\">\n##INFO=<ID=IX,Number=R,Type=Integer,Description=\"x\">\n#CHROM\tPOS\tID\tREF\tALT\tQUAL\tFILTER\tINFO\tFORMAT\tc\ta\n";
    let w = bio::hts_open(".tools/mapping-source.bcf", "wb", true, src, "");
    assert(bio::hts_write(w, "chr2\t7\t.\tA\tC,G\t.\tPASS\tIX=9,.,7;FX=0.5,.\tGT:VI:VF:ST\t0|2:1,.:0.5,.:alpha\t1:8:1:beta\t./1/2:3,4,5:.,2,3:gamma") == 0);
    assert(bio::hts_close(w) == 0);
    let r = bio::hts_open(".tools/mapping-source.bcf", "r", true, "", "");
    assert(bio::hts_next(r) == 1);
    let before = text(r);
    let out = bio::hts_open(".tools/mapping-output.bcf", "wb", true, dst, "");
    assert(bio::hts_copy_record(r, out) == -1);
    assert(bio::hts_copy_variant_mapped(r, out) == 0);
    assert(text(r) == before);
    let bad0 = bio::hts_open(".tools/mapping-bad0.bcf", "wb", true, "##fileformat=VCFv4.3\n##contig=<ID=chr2,length=100>\n##contig=<ID=chr1,length=100>\n##FORMAT=<ID=ST,Number=1,Type=String,Description=\"x\">\n##FORMAT=<ID=VF,Number=.,Type=Float,Description=\"x\">\n##FORMAT=<ID=VI,Number=.,Type=Integer,Description=\"x\">\n##FORMAT=<ID=GT,Number=1,Type=String,Description=\"x\">\n##INFO=<ID=FX,Number=A,Type=Float,Description=\"x\">\n##INFO=<ID=IX,Number=R,Type=Integer,Description=\"x\">\n#CHROM\tPOS\tID\tREF\tALT\tQUAL\tFILTER\tINFO\tFORMAT\tunknown\ta\n", "");
    assert(bio::hts_copy_variant_mapped(r, bad0) == -1);
    assert(text(r) == before);
    assert(bio::hts_close(bad0) == 0);
    let empty0 = bio::hts_open(".tools/mapping-bad0.bcf", "r", true, "", "");
    assert(bio::hts_next(empty0) == 0 && bio::hts_close(empty0) == 0);
    let bad1 = bio::hts_open(".tools/mapping-bad1.bcf", "wb", true, "##fileformat=VCFv4.3\n##contig=<ID=chr2,length=100>\n##contig=<ID=chr1,length=100>\n##FORMAT=<ID=ST,Number=1,Type=String,Description=\"x\">\n##FORMAT=<ID=VF,Number=.,Type=Float,Description=\"x\">\n##FORMAT=<ID=VI,Number=.,Type=Integer,Description=\"x\">\n##FORMAT=<ID=GT,Number=1,Type=String,Description=\"x\">\n##INFO=<ID=FX,Number=A,Type=Float,Description=\"x\">\n##INFO=<ID=OTHER,Number=R,Type=Integer,Description=\"x\">\n#CHROM\tPOS\tID\tREF\tALT\tQUAL\tFILTER\tINFO\tFORMAT\tc\ta\n", "");
    assert(bio::hts_copy_variant_mapped(r, bad1) == -1);
    assert(text(r) == before);
    assert(bio::hts_close(bad1) == 0);
    let empty1 = bio::hts_open(".tools/mapping-bad1.bcf", "r", true, "", "");
    assert(bio::hts_next(empty1) == 0 && bio::hts_close(empty1) == 0);
    let bad2 = bio::hts_open(".tools/mapping-bad2.bcf", "wb", true, "##fileformat=VCFv4.3\n##contig=<ID=chr2,length=100>\n##contig=<ID=chr1,length=100>\n##FORMAT=<ID=ST,Number=1,Type=String,Description=\"x\">\n##FORMAT=<ID=VF,Number=.,Type=Float,Description=\"x\">\n##FORMAT=<ID=VI,Number=.,Type=Integer,Description=\"x\">\n##FORMAT=<ID=GT,Number=1,Type=String,Description=\"x\">\n##INFO=<ID=FX,Number=A,Type=Float,Description=\"x\">\n##INFO=<ID=IX,Number=R,Type=Float,Description=\"x\">\n#CHROM\tPOS\tID\tREF\tALT\tQUAL\tFILTER\tINFO\tFORMAT\tc\ta\n", "");
    assert(bio::hts_copy_variant_mapped(r, bad2) == -1);
    assert(text(r) == before);
    assert(bio::hts_close(bad2) == 0);
    let empty2 = bio::hts_open(".tools/mapping-bad2.bcf", "r", true, "", "");
    assert(bio::hts_next(empty2) == 0 && bio::hts_close(empty2) == 0);
    let bad3 = bio::hts_open(".tools/mapping-bad3.bcf", "wb", true, "##fileformat=VCFv4.3\n##contig=<ID=chr2,length=100>\n##contig=<ID=chr1,length=100>\n##FORMAT=<ID=ST,Number=1,Type=String,Description=\"x\">\n##FORMAT=<ID=VF,Number=.,Type=Float,Description=\"x\">\n##FORMAT=<ID=VI,Number=.,Type=Integer,Description=\"x\">\n##FORMAT=<ID=GT,Number=1,Type=String,Description=\"x\">\n##INFO=<ID=FX,Number=A,Type=Float,Description=\"x\">\n##INFO=<ID=IX,Number=A,Type=Integer,Description=\"x\">\n#CHROM\tPOS\tID\tREF\tALT\tQUAL\tFILTER\tINFO\tFORMAT\tc\ta\n", "");
    assert(bio::hts_copy_variant_mapped(r, bad3) == -1);
    assert(text(r) == before);
    assert(bio::hts_close(bad3) == 0);
    let empty3 = bio::hts_open(".tools/mapping-bad3.bcf", "r", true, "", "");
    assert(bio::hts_next(empty3) == 0 && bio::hts_close(empty3) == 0);
    let bad4 = bio::hts_open(".tools/mapping-bad4.bcf", "wb", true, "##fileformat=VCFv4.3\n##contig=<ID=missing,length=100>\n##contig=<ID=chr1,length=100>\n##FORMAT=<ID=ST,Number=1,Type=String,Description=\"x\">\n##FORMAT=<ID=VF,Number=.,Type=Float,Description=\"x\">\n##FORMAT=<ID=VI,Number=.,Type=Integer,Description=\"x\">\n##FORMAT=<ID=GT,Number=1,Type=String,Description=\"x\">\n##INFO=<ID=FX,Number=A,Type=Float,Description=\"x\">\n##INFO=<ID=IX,Number=R,Type=Integer,Description=\"x\">\n#CHROM\tPOS\tID\tREF\tALT\tQUAL\tFILTER\tINFO\tFORMAT\tc\ta\n", "");
    assert(bio::hts_copy_variant_mapped(r, bad4) == -1);
    assert(text(r) == before);
    assert(bio::hts_close(bad4) == 0);
    let empty4 = bio::hts_open(".tools/mapping-bad4.bcf", "r", true, "", "");
    assert(bio::hts_next(empty4) == 0 && bio::hts_close(empty4) == 0);
    assert(bio::hts_copy_variant_mapped(r, out) == 0);
    assert(bio::hts_close(out) == 0);
    let reopened = bio::hts_open(".tools/mapping-output.bcf", "r", true, "", "");
    assert(bio::hts_next(reopened) == 1);
    assert(text(reopened) == "chr2\t7\t.\tA\tC,G\t.\tPASS\tIX=9,.,7;FX=0.5,.\tGT:VI:VF:ST\t./1/2:3,4,5:.,2,3:gamma\t0|2:1,.:0.5,.:alpha\n");
    assert(bio::bcf_int(reopened, "GT", true, 0) == 0);
    assert(bio::bcf_int(reopened, "GT", true, 1) == 4);
    assert(bio::bcf_int(reopened, "GT", true, 2) == 6);
    assert(bio::bcf_int(reopened, "GT", true, 5) == -2147483647);
    assert(bio::bcf_float_bits(reopened, "VF", true, 0) == 2139095041);
    assert(bio::bcf_float_bits(reopened, "VF", true, 5) == 2139095042);
    assert(bio::hts_next(reopened) == 1);
    assert(bio::hts_next(reopened) == 0 && bio::hts_close(reopened) == 0);
    rejected(src, "chr2\t7\t.\tA\tC,G\t.\tPASS\tIX=9,7\tGT\t0/1\t1\t0/2");
    assert(bio::hts_next(r) == 0);
    assert(bio::hts_copy_variant_mapped(r, r) == -1);
    assert(bio::hts_close(r) == 0);
}
