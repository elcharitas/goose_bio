        assert((cuta3.ids[5] == cuta3.ids[1]) == false);
        assert((cuta3.ids[5] == cuta3.ids[2]) == true);
        assert((cuta3.ids[5] == cuta3.ids[3]) == false);
        assert((cuta3.ids[5] == cuta3.ids[4]) == false);
        let cuta4 = bio::cluster_cut(ta, 4); assert(cuta4.error.len == 0);
        assert((cuta4.ids[1] == cuta4.ids[0]) == false);
        assert((cuta4.ids[2] == cuta4.ids[0]) == false);
        assert((cuta4.ids[2] == cuta4.ids[1]) == false);
        assert((cuta4.ids[3] == cuta4.ids[0]) == false);
        assert((cuta4.ids[3] == cuta4.ids[1]) == false);
        assert((cuta4.ids[3] == cuta4.ids[2]) == false);
        assert((cuta4.ids[4] == cuta4.ids[0]) == false);
        assert((cuta4.ids[4] == cuta4.ids[1]) == true);
        assert((cuta4.ids[4] == cuta4.ids[2]) == false);
        assert((cuta4.ids[4] == cuta4.ids[3]) == false);
        assert((cuta4.ids[5] == cuta4.ids[0]) == false);
        assert((cuta4.ids[5] == cuta4.ids[1]) == false);
        assert((cuta4.ids[5] == cuta4.ids[2]) == true);
        assert((cuta4.ids[5] == cuta4.ids[3]) == false);
        assert((cuta4.ids[5] == cuta4.ids[4]) == false);
        let cuta5 = bio::cluster_cut(ta, 5); assert(cuta5.error.len == 0);
        assert((cuta5.ids[1] == cuta5.ids[0]) == false);
        assert((cuta5.ids[2] == cuta5.ids[0]) == false);
        assert((cuta5.ids[2] == cuta5.ids[1]) == false);
        assert((cuta5.ids[3] == cuta5.ids[0]) == false);
        assert((cuta5.ids[3] == cuta5.ids[1]) == false);
        assert((cuta5.ids[3] == cuta5.ids[2]) == false);
        assert((cuta5.ids[4] == cuta5.ids[0]) == false);
        assert((cuta5.ids[4] == cuta5.ids[1]) == true);
        assert((cuta5.ids[4] == cuta5.ids[2]) == false);
        assert((cuta5.ids[4] == cuta5.ids[3]) == false);
        assert((cuta5.ids[5] == cuta5.ids[0]) == false);
        assert((cuta5.ids[5] == cuta5.ids[1]) == false);
        assert((cuta5.ids[5] == cuta5.ids[2]) == false);
        assert((cuta5.ids[5] == cuta5.ids[3]) == false);
        assert((cuta5.ids[5] == cuta5.ids[4]) == false);
        let cuta6 = bio::cluster_cut(ta, 6); assert(cuta6.error.len == 0);
        assert((cuta6.ids[1] == cuta6.ids[0]) == false);
        assert((cuta6.ids[2] == cuta6.ids[0]) == false);
        assert((cuta6.ids[2] == cuta6.ids[1]) == false);
        assert((cuta6.ids[3] == cuta6.ids[0]) == false);
        assert((cuta6.ids[3] == cuta6.ids[1]) == false);
        assert((cuta6.ids[3] == cuta6.ids[2]) == false);
        assert((cuta6.ids[4] == cuta6.ids[0]) == false);
        assert((cuta6.ids[4] == cuta6.ids[1]) == false);
        assert((cuta6.ids[4] == cuta6.ids[2]) == false);
        assert((cuta6.ids[4] == cuta6.ids[3]) == false);
        assert((cuta6.ids[5] == cuta6.ids[0]) == false);
        assert((cuta6.ids[5] == cuta6.ids[1]) == false);
        assert((cuta6.ids[5] == cuta6.ids[2]) == false);
        assert((cuta6.ids[5] == cuta6.ids[3]) == false);
        assert((cuta6.ids[5] == cuta6.ids[4]) == false);
    }
    print("clustering oracle: 30 seeded cases passed"); }
