import bio from "../..";
import bio.io.nmr_xpk;
fn main() {
let r0 = bio::parse_xpk("label dataset sw sf \nH N\noffline.nv\n{10} {20}\n{600} {60}\nN.P extra H.L N.L H.P vol\n  007\t10.0 KEEP -2.hn -2.n 7.0 0  \n9 14.0 SECOND -2.hn -2.n 9.0 5\n12 30.0 FINAL 3.hn 3.n 8.0 4\n"); assert(r0.error.len == 0); let p0 = copy(r0.peaklist);
assert(bio::xpk_field(p0.headers,0) == "label dataset sw sf ");
assert(bio::xpk_field(p0.headers,1) == "H N");
assert(bio::xpk_field(p0.headers,2) == "offline.nv");
assert(bio::xpk_field(p0.headers,3) == "{10} {20}");
assert(bio::xpk_field(p0.headers,4) == "{600} {60}");
assert(bio::xpk_field(p0.headers,5) == "N.P extra H.L N.L H.P vol");
let row0_0 = bio::xpk_row(p0,0); assert(row0_0.raw == "  007\t10.0 KEEP -2.hn -2.n 7.0 0  ");
assert(bio::xpk_field(row0_0.fields,1) == "10.0");
assert(bio::xpk_field(row0_0.fields,2) == "KEEP");
assert(bio::xpk_field(row0_0.fields,3) == "-2.hn");
assert(bio::xpk_field(row0_0.fields,4) == "-2.n");
assert(bio::xpk_field(row0_0.fields,5) == "7.0");
assert(bio::xpk_field(row0_0.fields,6) == "0");
assert(bio::xpk_field(row0_0.fields,0) == "007");
let row0_1 = bio::xpk_row(p0,1); assert(row0_1.raw == "9 14.0 SECOND -2.hn -2.n 9.0 5");
assert(bio::xpk_field(row0_1.fields,1) == "14.0");
assert(bio::xpk_field(row0_1.fields,2) == "SECOND");
assert(bio::xpk_field(row0_1.fields,3) == "-2.hn");
assert(bio::xpk_field(row0_1.fields,4) == "-2.n");
assert(bio::xpk_field(row0_1.fields,5) == "9.0");
assert(bio::xpk_field(row0_1.fields,6) == "5");
assert(bio::xpk_field(row0_1.fields,0) == "9");
let row0_2 = bio::xpk_row(p0,2); assert(row0_2.raw == "12 30.0 FINAL 3.hn 3.n 8.0 4");
assert(bio::xpk_field(row0_2.fields,1) == "30.0");
assert(bio::xpk_field(row0_2.fields,2) == "FINAL");
assert(bio::xpk_field(row0_2.fields,3) == "3.hn");
assert(bio::xpk_field(row0_2.fields,4) == "3.n");
assert(bio::xpk_field(row0_2.fields,5) == "8.0");
assert(bio::xpk_field(row0_2.fields,6) == "4");
assert(bio::xpk_field(row0_2.fields,0) == "12");
let g0 = bio::xpk_group(p0,"H"); assert(g0.minimum == -2 && g0.maximum == 3);
for group in g0.groups { if group.residue == -2 { assert(group.rows.len == 2);
assert(group.rows[0] == 0);
assert(group.rows[1] == 1);
} }
for group in g0.groups { if group.residue == 3 { assert(group.rows.len == 1);
assert(group.rows[0] == 2);
} }
assert(bio::write_xpk(p0) == "label dataset sw sf \nH N\noffline.nv\n{10} {20}\n{600} {60}\nN.P extra H.L N.L H.P vol\n  007\t10.0 KEEP -2.hn -2.n 7.0 0  \n9 14.0 SECOND -2.hn -2.n 9.0 5\n12 30.0 FINAL 3.hn 3.n 8.0 4\n"); let again0 = bio::parse_xpk(bio::write_xpk(p0)); assert(again0.error.len == 0);
let r1 = bio::parse_xpk("label dataset sw sf \nH N\noffline.nv\n{10} {20}\n{600} {60}\nN.P extra H.L N.L H.P vol\n4 0 RAW 0.hn 0.n 0 0\n"); assert(r1.error.len == 0); let p1 = copy(r1.peaklist);
assert(bio::xpk_field(p1.headers,0) == "label dataset sw sf ");
assert(bio::xpk_field(p1.headers,1) == "H N");
assert(bio::xpk_field(p1.headers,2) == "offline.nv");
assert(bio::xpk_field(p1.headers,3) == "{10} {20}");
assert(bio::xpk_field(p1.headers,4) == "{600} {60}");
assert(bio::xpk_field(p1.headers,5) == "N.P extra H.L N.L H.P vol");
let row1_0 = bio::xpk_row(p1,0); assert(row1_0.raw == "4 0 RAW 0.hn 0.n 0 0");
assert(bio::xpk_field(row1_0.fields,1) == "0");
assert(bio::xpk_field(row1_0.fields,2) == "RAW");
assert(bio::xpk_field(row1_0.fields,3) == "0.hn");
assert(bio::xpk_field(row1_0.fields,4) == "0.n");
assert(bio::xpk_field(row1_0.fields,5) == "0");
assert(bio::xpk_field(row1_0.fields,6) == "0");
assert(bio::xpk_field(row1_0.fields,0) == "4");
let g1 = bio::xpk_group(p1,"H"); assert(g1.minimum == 0 && g1.maximum == 0);
for group in g1.groups { if group.residue == 0 { assert(group.rows.len == 1);
assert(group.rows[0] == 0);
} }
assert(bio::write_xpk(p1) == "label dataset sw sf \nH N\noffline.nv\n{10} {20}\n{600} {60}\nN.P extra H.L N.L H.P vol\n4 0 RAW 0.hn 0.n 0 0\n"); let again1 = bio::parse_xpk(bio::write_xpk(p1)); assert(again1.error.len == 0);
let spectra: bio::Xpk[] = [copy(p0),copy(p1)]; let table = bio::xpk_table(spectra,"vol","H",100,100); assert(table.error.len == 0 && table.text == "-2\t0\t*\n-1\t*\t*\n0\t*\t0\n1\t*\t*\n2\t*\t*\n3\t4\t*\n");
let pred = bio::predict_xpk_noe(p0,"N","H",-2,3,false); assert(pred.found && pred.error.len == 0);
assert(bio::xpk_field(pred.row.fields,0) == "12");
let mean,ok = bio::xpk_number(bio::xpk_field(pred.row.fields,1)); assert(ok && mean == 12.0);
assert(bio::xpk_field(pred.row.fields,2) == "FINAL");
assert(bio::xpk_field(pred.row.fields,3) == "3.hn");
assert(bio::xpk_field(pred.row.fields,4) == "-2.n");
assert(bio::xpk_field(pred.row.fields,5) == "8.0");
assert(bio::xpk_field(pred.row.fields,6) == "4");
assert(!bio::predict_xpk_noe(p0,"N","H",99,3,false).found);
let one: bio::Xpk[] = [copy(p0)]; let bounded = bio::xpk_table(one,"vol","H",2,100); assert(bounded.error.len > 0);
assert(bio::parse_xpk("").error.len > 0);
assert(bio::parse_xpk("label dataset sw sf \nH N\noffline.nv\n{10} {20}\n{600} {60}").error.len > 0);
assert(bio::parse_xpk("label dataset sw sf \nH N\noffline.nv\n{10} {20}\n{600} {60}\nN.P extra H.L N.L H.P vol\n1 0 x bad 1.n 1 0").error.len > 0);
assert(bio::parse_xpk("label dataset sw sf \nH N\noffline.nv\n{10} {20}\n{600} {60}\nN.P extra H.L N.L H.P vol\n1 nan x 1.h 1.n 1 0").error.len > 0);
assert(bio::parse_xpk("label dataset sw sf \nH N\noffline.nv\n{10} {20}\n{600} {60}\nN.P extra H.L N.L H.P vol\n1 0 x {1.h,2.h} 1.n 1 0").error.len > 0);
assert(bio::parse_xpk("label dataset sw sf \nH N\noffline.nv\n{10} {20}\n{600} {60}\nN.P extra H.L N.L H.P vol\n1 0 x 1.h 1.n 1").error.len > 0);
assert(bio::parse_xpk("label dataset sw sf \nH N\noffline.nv\n{10} {20}\n{600} {60}\nH.L H.P H.P").error.len > 0);
let empty = bio::parse_xpk("label dataset sw sf \nH N\noffline.nv\n{10} {20}\n{600} {60}\nN.P extra H.L N.L H.P vol\n"); let eg = bio::xpk_group(empty.peaklist,"H"); assert(eg.minimum == -1 && eg.maximum == -1);
let off = bio::parse_xpk("label dataset sw sf \nH N\noffline.nv\n{10} {20}\n{600} {60}\nN.P extra H.L N.L H.P vol\n1 1 x 2.h 3.n 2 0\n"); assert(bio::predict_xpk_noe(off.peaklist,"N","H",2,2,false).error.len > 0); assert(bio::predict_xpk_noe(off.peaklist,"N","H",2,2,true).found);
}
