import std;
import bio from "..";
import bio.sequence.protein;
import bio.alignment.substitution;
fn close(a: f64, b: f64, tolerance: f64) { assert(abs(a-b) <= tolerance); }
fn replay(r: const bio::MatrixAlignment&, a: const u8[:], b: const u8[:], m: const bio::SubstitutionMatrix&) {
    var i = r.a_start; var j = r.b_start; var score = 0.0;
    assert(r.a_aligned.len == r.b_aligned.len);
    for c, k in r.a_aligned {
        let d = r.b_aligned[k];
        assert(c != '-' || d != '-');
        if c == '-' || d == '-' { score -= 3.25; }
        else { score += bio::substitution_score(m,r.a_aligned[k..k+1],r.b_aligned[k..k+1]).value; }
        if c != '-' { assert(c == a[i]); i += 1; }
        if d != '-' { assert(d == b[j]); j += 1; }
    }
    assert(i == r.a_end && j == r.b_end);
    close(score,r.score,1.0e-8);
}
fn main() {
    let p0 = bio::protein_properties("ACDEFGHIKLMNPQRSTVWY", 0.0, false);
    assert(p0.error.len == 0);
    close(p0.molecular_weight, 2395.7134, 1e-07);
    close(p0.aromaticity, 0.15000000000000002, 1e-09);
    close(p0.gravy, -0.49000000000000005, 1e-09);
    close(p0.charge, 3.999592569853626, 1e-09);
    close(p0.isoelectric_point, 6.784552192687988, 1e-09);
    close(p0.helix, 0.25, 1e-09);
    close(p0.turn, 0.25, 1e-09);
    close(p0.sheet, 0.35000000000000003, 1e-09);
    assert(p0.extinction_reduced == 6990 && p0.extinction_disulfide == 6990);
    assert(p0.counts[0] == 1);
    close(p0.fractions[0], 0.05, 1.0e-12);
    assert(p0.counts[1] == 1);
    close(p0.fractions[1], 0.05, 1.0e-12);
