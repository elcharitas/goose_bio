import bio_index from "..";
import os;
fn main() {
    assert(bio_index::build(".tools/index.fa", ".tools/index.db") == 0);
    let h = bio_index::open(".tools/index.db");
    assert(h > 0);
    assert(bio_index::count(h) == 3);
    assert(bio_index::keys(h).value.len == 3);
    assert(bio_index::key_at(h, 1).value == "empty");
    assert(bio_index::get_raw(h, "b").value == ">b\nTT\nAA");
    assert(bio_index::get_record(h, "a").value.sequence == "ACGT");
    assert(bio_index::get_record(h, "empty").value.sequence == "");
    assert(bio_index::get_raw(h, "missing").error.len > 0);
    assert(bio_index::close(h) == 0);
    assert(bio_index::close(h) == -1);
    assert(bio_index::count(h) == -1);
    assert(bio_index::build(".tools/duplicate.fa", ".tools/index.db") == -1);
    let reopened = bio_index::open(".tools/index.db");
    assert(bio_index::count(reopened) == 3);
    assert(bio_index::close(reopened) == 0);
    assert(bio_index::build(".tools/index.fa", ".tools/index.fa") == -1);
    assert(bio_index::build(".tools/bad.fq", ".tools/bad.db") == -1);
    assert(bio_index::build(".tools/index.fa", ".tools/index-hard.fa") == -1);
    assert(bio_index::build(".tools/index.fa", ".tools/index-link.fa") == -1);
    assert(write_file(".tools/changing.fa", ">x\nAA\n"));
    assert(bio_index::build(".tools/changing.fa", ".tools/changing.db") == 0);
    let changing = bio_index::open(".tools/changing.db");
    assert(changing > 0);
    assert(write_file(".tools/changing.fa", ">x\nCC\n"));
    assert(bio_index::get_raw(changing, "x").error.len > 0);
    assert(bio_index::close(changing) == 0);
    assert(bio_index::open(".tools/changing.db") == 0);
    assert(bio_index::build(".tools/changing.fa", ".tools/changing.db") == 0);
    let truncated = bio_index::open(".tools/changing.db");
    assert(truncated > changing);
    assert(write_file(".tools/changing.fa", ">x"));
    assert(bio_index::count(truncated) == -1);
    assert(bio_index::close(truncated) == 0);
    assert(bio_index::build(".tools/empty.fa", ".tools/empty.db") == 0);
    let empty = bio_index::open(".tools/empty.db");
    assert(bio_index::count(empty) == 0);
    assert(bio_index::close(empty) == 0);
}
