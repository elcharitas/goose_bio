import bio_http from "..";
fn main() {
    let entrez = "{\"header\": {\"type\": \"esearch\", \"version\": \"0.3\"}, \"esearchresult\": {\"count\": \"10\", \"retmax\": \"2\", \"retstart\": \"4\", \"idlist\": [\"001\", \"9223372036854775807\"], \"querykey\": \"1\", \"webenv\": \"fixture-history\", \"querytranslation\": \"x\", \"extension\": {\"null\": null, \"number\": 123456789012345678901234567890}}}";
    let r = bio_http::parse_entrez_search(entrez);
    assert(r.error.len == 0);
    assert(r.raw == entrez);
    assert(r.count.value == 10 && r.count.state == 2);
    assert(r.retmax.value == 2 && r.retstart.value == 4);
    assert(r.ids.len == 2);
    for id, i in r.ids { assert(id == (if i == 0 { "001" } else { "9223372036854775807" })); }
    assert(r.query_key.value == 1 && r.webenv.value == "fixture-history");
    let uniprot = "{\"primaryAccession\": \"P04637\", \"secondaryAccessions\": [\"Q15086\"], \"uniProtkbId\": \"P53_HUMAN\", \"entryType\": \"UniProtKB reviewed (Swiss-Prot)\", \"sequence\": {\"value\": \"MPE\", \"length\": 3, \"molWeight\": 1, \"crc64\": \"fixture\"}, \"entryAudit\": {\"entryVersion\": 1}, \"organism\": {\"taxonId\": 9606}, \"proteinDescription\": {\"recommendedName\": {\"fullName\": {\"value\": \"fixture\"}}}, \"future\": {\"x\": [null, false, {\"large\": 123456789012345678901234567890}]}}";
    let u = bio_http::parse_uniprot_entry(uniprot);
    assert(u.error.len == 0 && u.raw == uniprot);
    assert(u.entries.len == 1);
    for e in u.entries { assert(e.accession.value == "P04637"); }
    for e in u.entries { assert(e.id.value == "P53_HUMAN"); }
    for e in u.entries { assert(e.entry_type.state == 2); }
    for e in u.entries { assert(e.sequence.value == "MPE" && e.length.value == 3); }
    let page = bio_http::parse_uniprot_search("{\"results\": [{\"primaryAccession\": \"P04637\", \"secondaryAccessions\": [\"Q15086\"], \"uniProtkbId\": \"P53_HUMAN\", \"entryType\": \"UniProtKB reviewed (Swiss-Prot)\", \"sequence\": {\"value\": \"MPE\", \"length\": 3, \"molWeight\": 1, \"crc64\": \"fixture\"}, \"entryAudit\": {\"entryVersion\": 1}, \"organism\": {\"taxonId\": 9606}, \"proteinDescription\": {\"recommendedName\": {\"fullName\": {\"value\": \"fixture\"}}}, \"future\": {\"x\": [null, false, {\"large\": 123456789012345678901234567890}]}}, {\"primaryAccession\": \"Q00001\"}], \"extension\": null}");
    assert(page.error.len == 0 && page.entries.len == 2);
    for e, i in page.entries { if i == 1 { assert(e.sequence.state == 0 && e.id.state == 0); } }
    assert(bio_http::parse_uniprot_search("{\"results\":[]}").error.len == 0);
    assert(bio_http::parse_uniprot_search("{\"results\":[],\"other\":{\"a\":null}}").error.len == 0);
    let empty = bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"retstart\": 0, \"idlist\": []}}");
    assert(empty.error.len == 0 && empty.ids.len == 0 && empty.webenv.state == 0 && empty.query_key.state == 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": \"0\", \"retmax\": 0, \"retstart\": 0, \"idlist\": []}}").error.len == 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": \"9223372036854775807\", \"retmax\": 0, \"retstart\": 0, \"idlist\": []}}").error.len == 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"retstart\": 0, \"idlist\": []}}").error.len == 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 9223372036854775807, \"retmax\": 0, \"retstart\": 0, \"idlist\": []}}").error.len == 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": null, \"retmax\": 0, \"retstart\": 0, \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": true, \"retmax\": 0, \"retstart\": 0, \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": {}, \"retmax\": 0, \"retstart\": 0, \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": [], \"retmax\": 0, \"retstart\": 0, \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": -1, \"retmax\": 0, \"retstart\": 0, \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": \"-1\", \"retmax\": 0, \"retstart\": 0, \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": \"\", \"retmax\": 0, \"retstart\": 0, \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": \"1.0\", \"retmax\": 0, \"retstart\": 0, \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": \"1e2\", \"retmax\": 0, \"retstart\": 0, \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": \"9223372036854775808\", \"retmax\": 0, \"retstart\": 0, \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 9223372036854775808, \"retmax\": 0, \"retstart\": 0, \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 1.5, \"retmax\": 0, \"retstart\": 0, \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": null, \"retstart\": 0, \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": true, \"retstart\": 0, \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": {}, \"retstart\": 0, \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": [], \"retstart\": 0, \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": -1, \"retstart\": 0, \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": \"-1\", \"retstart\": 0, \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": \"\", \"retstart\": 0, \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": \"1.0\", \"retstart\": 0, \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": \"1e2\", \"retstart\": 0, \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": \"9223372036854775808\", \"retstart\": 0, \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 9223372036854775808, \"retstart\": 0, \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 1.5, \"retstart\": 0, \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"retstart\": null, \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"retstart\": true, \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"retstart\": {}, \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"retstart\": [], \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"retstart\": -1, \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"retstart\": \"-1\", \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"retstart\": \"\", \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"retstart\": \"1.0\", \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"retstart\": \"1e2\", \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"retstart\": \"9223372036854775808\", \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"retstart\": 9223372036854775808, \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"retstart\": 1.5, \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"retstart\": 0, \"idlist\": [], \"querykey\": null}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"retstart\": 0, \"idlist\": [], \"querykey\": true}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"retstart\": 0, \"idlist\": [], \"querykey\": {}}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"retstart\": 0, \"idlist\": [], \"querykey\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"retstart\": 0, \"idlist\": [], \"querykey\": -1}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"retstart\": 0, \"idlist\": [], \"querykey\": \"-1\"}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"retstart\": 0, \"idlist\": [], \"querykey\": \"\"}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"retstart\": 0, \"idlist\": [], \"querykey\": \"1.0\"}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"retstart\": 0, \"idlist\": [], \"querykey\": \"1e2\"}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"retstart\": 0, \"idlist\": [], \"querykey\": \"9223372036854775808\"}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"retstart\": 0, \"idlist\": [], \"querykey\": 9223372036854775808}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"retstart\": 0, \"idlist\": [], \"querykey\": 1.5}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"retmax\": 0, \"retstart\": 0, \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retstart\": 0, \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"idlist\": []}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"retstart\": 0}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"retstart\": 0, \"idlist\": [1]}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"retstart\": 0, \"idlist\": [null]}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"retstart\": 0, \"idlist\": [\"x\"]}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"retstart\": 0, \"idlist\": [\"9223372036854775808\"]}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"retstart\": 0, \"idlist\": null}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"retstart\": 0, \"idlist\": [], \"webenv\": null}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"retstart\": 0, \"idlist\": [], \"webenv\": 3}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"retstart\": 0, \"idlist\": [], \"webenv\": \"alone\"}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"retstart\": 0, \"idlist\": [], \"querykey\": \"1\"}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"retstart\": 0, \"idlist\": [], \"errorlist\": {\"phrasesnotfound\": [\"x\"]}}}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\": {\"count\": 0, \"retmax\": 0, \"retstart\": 0, \"idlist\": [], \"ERROR\": \"bad\"}}").error.len > 0);
    assert(bio_http::parse_entrez_search("").error.len > 0);
    assert(bio_http::parse_entrez_search("{").error.len > 0);
    assert(bio_http::parse_entrez_search("null").error.len > 0);
    assert(bio_http::parse_entrez_search("[]").error.len > 0);
    assert(bio_http::parse_entrez_search("{}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"error\":\"bad\"}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"esearchresult\":null}").error.len > 0);
    assert(bio_http::parse_entrez_search("{\"x\":1,\"x\":2}").error.len > 0);
    assert(bio_http::parse_uniprot_search("").error.len > 0);
    assert(bio_http::parse_uniprot_search("{").error.len > 0);
    assert(bio_http::parse_uniprot_search("null").error.len > 0);
    assert(bio_http::parse_uniprot_search("[]").error.len > 0);
    assert(bio_http::parse_uniprot_search("{}").error.len > 0);
    assert(bio_http::parse_uniprot_search("{\"results\":null}").error.len > 0);
    assert(bio_http::parse_uniprot_search("{\"results\":{}}").error.len > 0);
    assert(bio_http::parse_uniprot_search("{\"results\":[null]}").error.len > 0);
    assert(bio_http::parse_uniprot_search("{\"messages\":[\"bad\"]}").error.len > 0);
    assert(bio_http::parse_uniprot_search("{\"results\":[],\"x\":{\"a\":1,\"a\":2}}").error.len > 0);
    assert(bio_http::parse_uniprot_entry("{\"primaryAccession\": null, \"secondaryAccessions\": [\"Q15086\"], \"uniProtkbId\": \"P53_HUMAN\", \"entryType\": \"UniProtKB reviewed (Swiss-Prot)\", \"sequence\": {\"value\": \"MPE\", \"length\": 3, \"molWeight\": 1, \"crc64\": \"fixture\"}, \"entryAudit\": {\"entryVersion\": 1}, \"organism\": {\"taxonId\": 9606}, \"proteinDescription\": {\"recommendedName\": {\"fullName\": {\"value\": \"fixture\"}}}, \"future\": {\"x\": [null, false, {\"large\": 123456789012345678901234567890}]}}").error.len > 0);
    assert(bio_http::parse_uniprot_entry("{\"primaryAccession\": 1, \"secondaryAccessions\": [\"Q15086\"], \"uniProtkbId\": \"P53_HUMAN\", \"entryType\": \"UniProtKB reviewed (Swiss-Prot)\", \"sequence\": {\"value\": \"MPE\", \"length\": 3, \"molWeight\": 1, \"crc64\": \"fixture\"}, \"entryAudit\": {\"entryVersion\": 1}, \"organism\": {\"taxonId\": 9606}, \"proteinDescription\": {\"recommendedName\": {\"fullName\": {\"value\": \"fixture\"}}}, \"future\": {\"x\": [null, false, {\"large\": 123456789012345678901234567890}]}}").error.len > 0);
    assert(bio_http::parse_uniprot_entry("{\"primaryAccession\": \"\", \"secondaryAccessions\": [\"Q15086\"], \"uniProtkbId\": \"P53_HUMAN\", \"entryType\": \"UniProtKB reviewed (Swiss-Prot)\", \"sequence\": {\"value\": \"MPE\", \"length\": 3, \"molWeight\": 1, \"crc64\": \"fixture\"}, \"entryAudit\": {\"entryVersion\": 1}, \"organism\": {\"taxonId\": 9606}, \"proteinDescription\": {\"recommendedName\": {\"fullName\": {\"value\": \"fixture\"}}}, \"future\": {\"x\": [null, false, {\"large\": 123456789012345678901234567890}]}}").error.len > 0);
    assert(bio_http::parse_uniprot_entry("{\"primaryAccession\": \"P04637\", \"secondaryAccessions\": [\"Q15086\"], \"uniProtkbId\": null, \"entryType\": \"UniProtKB reviewed (Swiss-Prot)\", \"sequence\": {\"value\": \"MPE\", \"length\": 3, \"molWeight\": 1, \"crc64\": \"fixture\"}, \"entryAudit\": {\"entryVersion\": 1}, \"organism\": {\"taxonId\": 9606}, \"proteinDescription\": {\"recommendedName\": {\"fullName\": {\"value\": \"fixture\"}}}, \"future\": {\"x\": [null, false, {\"large\": 123456789012345678901234567890}]}}").error.len > 0);
    assert(bio_http::parse_uniprot_entry("{\"primaryAccession\": \"P04637\", \"secondaryAccessions\": [\"Q15086\"], \"uniProtkbId\": \"P53_HUMAN\", \"entryType\": [], \"sequence\": {\"value\": \"MPE\", \"length\": 3, \"molWeight\": 1, \"crc64\": \"fixture\"}, \"entryAudit\": {\"entryVersion\": 1}, \"organism\": {\"taxonId\": 9606}, \"proteinDescription\": {\"recommendedName\": {\"fullName\": {\"value\": \"fixture\"}}}, \"future\": {\"x\": [null, false, {\"large\": 123456789012345678901234567890}]}}").error.len > 0);
    assert(bio_http::parse_uniprot_entry("{\"primaryAccession\": \"P04637\", \"secondaryAccessions\": [\"Q15086\"], \"uniProtkbId\": \"P53_HUMAN\", \"entryType\": \"UniProtKB reviewed (Swiss-Prot)\", \"sequence\": null, \"entryAudit\": {\"entryVersion\": 1}, \"organism\": {\"taxonId\": 9606}, \"proteinDescription\": {\"recommendedName\": {\"fullName\": {\"value\": \"fixture\"}}}, \"future\": {\"x\": [null, false, {\"large\": 123456789012345678901234567890}]}}").error.len > 0);
    assert(bio_http::parse_uniprot_entry("{\"primaryAccession\": \"P04637\", \"secondaryAccessions\": [\"Q15086\"], \"uniProtkbId\": \"P53_HUMAN\", \"entryType\": \"UniProtKB reviewed (Swiss-Prot)\", \"sequence\": [], \"entryAudit\": {\"entryVersion\": 1}, \"organism\": {\"taxonId\": 9606}, \"proteinDescription\": {\"recommendedName\": {\"fullName\": {\"value\": \"fixture\"}}}, \"future\": {\"x\": [null, false, {\"large\": 123456789012345678901234567890}]}}").error.len > 0);
    assert(bio_http::parse_uniprot_entry("{\"primaryAccession\": \"P04637\", \"secondaryAccessions\": [\"Q15086\"], \"uniProtkbId\": \"P53_HUMAN\", \"entryType\": \"UniProtKB reviewed (Swiss-Prot)\", \"sequence\": {}, \"entryAudit\": {\"entryVersion\": 1}, \"organism\": {\"taxonId\": 9606}, \"proteinDescription\": {\"recommendedName\": {\"fullName\": {\"value\": \"fixture\"}}}, \"future\": {\"x\": [null, false, {\"large\": 123456789012345678901234567890}]}}").error.len > 0);
    assert(bio_http::parse_uniprot_entry("{\"primaryAccession\": \"P04637\", \"secondaryAccessions\": [\"Q15086\"], \"uniProtkbId\": \"P53_HUMAN\", \"entryType\": \"UniProtKB reviewed (Swiss-Prot)\", \"sequence\": {\"value\": \"ABC\", \"length\": 2}, \"entryAudit\": {\"entryVersion\": 1}, \"organism\": {\"taxonId\": 9606}, \"proteinDescription\": {\"recommendedName\": {\"fullName\": {\"value\": \"fixture\"}}}, \"future\": {\"x\": [null, false, {\"large\": 123456789012345678901234567890}]}}").error.len > 0);
    assert(bio_http::parse_uniprot_entry("{\"primaryAccession\": \"P04637\", \"secondaryAccessions\": [\"Q15086\"], \"uniProtkbId\": \"P53_HUMAN\", \"entryType\": \"UniProtKB reviewed (Swiss-Prot)\", \"sequence\": {\"value\": null, \"length\": 0}, \"entryAudit\": {\"entryVersion\": 1}, \"organism\": {\"taxonId\": 9606}, \"proteinDescription\": {\"recommendedName\": {\"fullName\": {\"value\": \"fixture\"}}}, \"future\": {\"x\": [null, false, {\"large\": 123456789012345678901234567890}]}}").error.len > 0);
    assert(bio_http::parse_uniprot_entry("{\"primaryAccession\": \"P04637\", \"secondaryAccessions\": [\"Q15086\"], \"uniProtkbId\": \"P53_HUMAN\", \"entryType\": \"UniProtKB reviewed (Swiss-Prot)\", \"sequence\": {\"value\": \"\", \"length\": \"0\"}, \"entryAudit\": {\"entryVersion\": 1}, \"organism\": {\"taxonId\": 9606}, \"proteinDescription\": {\"recommendedName\": {\"fullName\": {\"value\": \"fixture\"}}}, \"future\": {\"x\": [null, false, {\"large\": 123456789012345678901234567890}]}}").error.len > 0);
    assert(bio_http::parse_uniprot_entry("{\"primaryAccession\": \"P04637\", \"secondaryAccessions\": [\"Q15086\"], \"uniProtkbId\": \"P53_HUMAN\", \"entryType\": \"UniProtKB reviewed (Swiss-Prot)\", \"sequence\": {\"value\": \"\", \"length\": 0.0}, \"entryAudit\": {\"entryVersion\": 1}, \"organism\": {\"taxonId\": 9606}, \"proteinDescription\": {\"recommendedName\": {\"fullName\": {\"value\": \"fixture\"}}}, \"future\": {\"x\": [null, false, {\"large\": 123456789012345678901234567890}]}}").error.len > 0);
    assert(bio_http::json_text(null).state == 0);
    assert(bio_http::parse_uniprot_entry("{\"primaryAccession\": \"P\", \"uniProtkbId\": null}").error.len > 0);
    assert(bio_http::parse_uniprot_entry("{\"primaryAccession\": \"P\", \"uniProtkbId\": \"hello\"}").error.len == 0);
    assert(bio_http::parse_uniprot_entry("{\"primaryAccession\": \"P\", \"uniProtkbId\": 12}").error.len > 0);
    let base = "http://127.0.0.1:18769";
    let http = bio_http::request("GET", bio_http::join(base,"/json-entrez"));
    assert(bio_http::entrez_search_response(copy(http)).count.value == 0);
    let up = bio_http::request("GET", bio_http::join(base,"/json-uniprot"));
    assert(bio_http::uniprot_response(copy(up)).entries.len == 1);
    let next = bio_http::request("GET", bio_http::next_link(up.headers));
    assert(bio_http::uniprot_response(copy(next)).entries.len == 0);
    assert(bio_http::uniprot_response(bio_http::request("GET",bio_http::join(base,"/json-bad"))).error.len > 0);
    assert(bio_http::uniprot_response(bio_http::request("GET",bio_http::join(base,"/json-error"))).error.len > 0);
    assert(bio_http::uniprot_response(bio_http::request("GET",bio_http::join(base,"/redirect"))).error.len > 0);
    let blocked = bio_http::GooseHttpResult { 404, "{", "", "", 0 };
    assert(bio_http::uniprot_response(copy(blocked)).error == "HTTP status is not 200; see HTTP result");
    assert(bio_http::entrez_search_response(copy(blocked)).error == "HTTP status is not 200; see HTTP result");
    let partial = bio_http::GooseHttpResult { 200, "{", "", "partial", 1 };
    assert(bio_http::uniprot_response(copy(partial)).error == "transport error; see HTTP result");
    assert(bio_http::entrez_search_response(copy(partial)).error == "transport error; see HTTP result");
    let null_count = bio_http::parse_entrez_search("{\"esearchresult\":{\"count\":null,\"retmax\":0,\"retstart\":0,\"idlist\":[]}}");
    let wrong_count = bio_http::parse_entrez_search("{\"esearchresult\":{\"count\":false,\"retmax\":0,\"retstart\":0,\"idlist\":[]}}");
    let missing_count = bio_http::parse_entrez_search("{\"esearchresult\":{\"retmax\":0,\"retstart\":0,\"idlist\":[]}}");
    assert(null_count.count.state == 1 && wrong_count.count.state == 3 && missing_count.count.state == 0);

}
