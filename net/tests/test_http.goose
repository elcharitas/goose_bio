import bio_http from "..";
fn main() {
    let base = "http://127.0.0.1:18769";
    let ok = bio_http::request("GET", bio_http::join(base, "/ok"));
    assert(ok.status == 200 && ok.body == "hello" && ok.error.len == 0);
    assert(bio_http::request("GET", bio_http::join(base, "/missing")).status == 404);
    assert(bio_http::request("GET", bio_http::join(base, "/redirect")).status == 302);
    assert(bio_http::request("GET", bio_http::join(base, "/ok"), "", 1000, 2).code != 0);
    assert(bio_http::request("GET", bio_http::join(base, "/ok"), "", 1000, 100, 2).code != 0);
    assert(bio_http::request("GET", bio_http::join(base, "/slow"), "", 20).code != 0);
    assert(bio_http::request("GET", "file:///etc/hosts").code != 0);
    assert(bio_http::request("GET", "http://user:pass@127.0.0.1:18769").code != 0);
    assert(bio_http::request("BAD", base).code != 0);
    assert(bio_http::request("GET", "http://[").code != 0);
    assert(bio_http::request("POST", bio_http::join(base, "/echo"), "a\0b").body == "a\0b");
    assert(bio_http::get_retry(bio_http::join(base, "/retry"), 2).status == 200);
    assert(bio_http::get_retry(base, 3).code == -1);
    assert(bio_http::encode("a b&/\xFF") == "a%20b%26%2F%FF");
    let page = bio_http::request("GET", bio_http::join(base, "/page"));
    assert(bio_http::request("GET", bio_http::next_link(page.headers)).body == "hello");
    assert(bio_http::request("GET", bio_http::entrez_search("nuccore", "a b&c", base)).body == "encoded");
    assert(bio_http::request("GET", bio_http::join(base, "/malformed")).code != 0);
    let h = bio_http::native_start("GET", bio_http::join(base, "/ok"), "", 1000, 100, 1000);
    assert(h > 0 && bio_http::native_close(h) == 0);
    assert(bio_http::native_close(h) == -1);
    assert(bio_http::native_number(h, 0) == -1);
    assert(bio_http::next_link("Other: <http://bad>; rel=\"next\"\r\n") == "");
    assert(bio_http::native_close(999999) == -1);
    assert(bio_http::native_number(999999, 0) == -1);
    assert(bio_http::entrez_fetch("db", "1,2", "gb", "text", base) == "http://127.0.0.1:18769/efetch.fcgi?db=db&id=1%2C2&rettype=gb&retmode=text");
    assert(bio_http::entrez_history("db", "a&b", "1", "0", "2", base) == "http://127.0.0.1:18769/efetch.fcgi?db=db&WebEnv=a%26b&query_key=1&retstart=0&retmax=2");
    assert(bio_http::uniprot_search("a:b", base) == "http://127.0.0.1:18769/uniprotkb/search?query=a%3Ab&format=json");
    assert(bio_http::uniprot_fetch("A/B", "fasta", base) == "http://127.0.0.1:18769/uniprotkb/A%2FB.fasta");
    assert(bio_http::kegg("get", "hsa:1", base) == "http://127.0.0.1:18769/get/hsa%3A1");
    assert(bio_http::togows("uniprot", "A B", "fasta", base) == "http://127.0.0.1:18769/entry/uniprot/A%20B.fasta");
    assert(bio_http::expasy("P12345", base) == "http://127.0.0.1:18769/uniprotkb/P12345.txt");
    let head = bio_http::request("HEAD", bio_http::join(base, "/ok"));
    assert(head.status == 200 && head.code == 0 && head.body.len == 0);
    assert(bio_http::next_link("link: <http://old>; rel=\"prev\", <http://new>; rel=\"next\"\r\n") == "http://new");
    assert(bio_http::next_link("HTTP/1.1 103 Early Hints\r\nLink: <old>; rel=next\r\n\r\nHTTP/1.1 200 OK\r\nLiNk: <new>; ReL=\"prev NEXT\"\r\n\r\n") == "new");
    assert(bio_http::next_link("HTTP/1.1 103 Early Hints\r\nLink: <old>; rel=next\r\n\r\nHTTP/2 200\r\n\r\n") == "");
    assert(bio_http::next_link("Link: <bad>; xrel=\"next\", <good>; REL = next\r\n") == "good");
    assert(bio_http::next_link("Link: <bad>; title=\"rel=next, next\"; rel=prev, <good>; title=\"a,b\"; rel=\"prev next\"\r\n") == "good");
    assert(bio_http::next_link("Link: <bad>; rel=nextish\r\n") == "");
    assert(bio_http::next_link("Link: <bad>; rel=\"next\r\n") == "");
    let hints = bio_http::request("GET", bio_http::join(base, "/hints"));
    assert(hints.status == 200 && bio_http::next_link(hints.headers) == "new");
    assert(bio_http::kegg("..", "probe", base) == "");
    assert(bio_http::kegg(".", "probe", base) == "");
    assert(bio_http::kegg("get", "..", base) == "");
    assert(bio_http::kegg("get", ".", base) == "");
    assert(bio_http::togows("..", "probe", "fasta", base) == "");
    assert(bio_http::togows(".", "probe", "fasta", base) == "");
    assert(bio_http::request("GET", bio_http::kegg("..", "probe", base)).code != 0);
    assert(bio_http::request("GET", bio_http::entrez_search("..", ".", base)).body == "dots");
    assert(bio_http::request("GET", "https://127.0.0.1:18770/ok").code != 0);
    assert(bio_http::request("GET", "http://127.0.0.1:18769/ok\0evil").code != 0);
    assert(bio_http::request("GET", "http://127.0.0.1:18769/ok\r\nevil").code != 0);
    assert(bio_http::uniprot_fetch("", "", base) == "");
    assert(bio_http::uniprot_fetch(".", "", base) == "");
    assert(bio_http::uniprot_fetch("", ".", base) == "");
    assert(bio_http::togows("db", "", "", base) == "");
    assert(bio_http::togows("db", ".", "", base) == "");
    assert(bio_http::togows("db", "", ".", base) == "");
    print("HTTP fixture tests passed");
}
