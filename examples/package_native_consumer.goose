import bio from "../goose_bio";
import hts from "../goose_bio";
import bio.hts;
import bio_http from "../goose_bio/net";
import bio_index from "../goose_bio/index";
fn main() {
    assert(bio::reverse_complement("ACGTAA").value == "TTACGT");
    let w = bio::hts_open("out.sam", "w", false, "@HD\tVN:1.6\n@SQ\tSN:chr1\tLN:100\n", "");
    assert(w > 0);
    assert(bio::hts_write(w, "r1\t0\tchr1\t5\t60\t4M\t*\t0\t0\tACGT\tIIII") == 0);
    assert(bio::hts_close(w) == 0);
    assert(bio::hts_close(w) == -1);
    let r = bio::hts_open("out.sam", "r", false, "", "");
    assert(r > 0 && bio::hts_next(r) == 1);
    assert(bio::hts_position(r) == 4 && bio::hts_mapq(r) == 60);
    var sequence: u8[>..] = [];
    assert(bio::bam_sequence(r, sequence) == 0 && sequence[..] == "ACGT");
    assert(bio::hts_next(r) == 0 && bio::hts_close(r) == 0);
    assert(bio::hts_open("absent.sam", "r", false, "", "") == 0);
    let b = bio::bgzf_open("out.bgzf", true);
    assert(b > 0 && bio::bgzf_write(b, "ACGT\n") == 0);
    assert(bio::bgzf_close(b) == 0 && bio::bgzf_close(b) == -1);
    let br = bio::bgzf_open("out.bgzf", false);
    var bytes: u8[>..] = [];
    assert(br > 0 && bio::bgzf_read(br, 5, bytes) == 5);
    assert(bytes[..] == "ACGT\n" && bio::bgzf_close(br) == 0);
    var fetched: u8[>..] = [];
    assert(bio::hts_fasta_fetch("input.fa", "a", 1, 4, fetched) == 0);
    assert(fetched[..] == "CGT");
    assert(bio_index::build("input.fa", "out.db") == 0);
    let db = bio_index::open("out.db");
    assert(db > 0 && bio_index::count(db) == 2);
    assert(bio_index::get_record(db, "a").value.sequence == "ACGT");
    assert(bio_index::get_raw(db, "missing").error.len > 0);
    assert(bio_index::close(db) == 0 && bio_index::close(db) == -1);
    let reopened = bio_index::open("out.db");
    assert(reopened > 0 && bio_index::get_record(reopened, "b").value.sequence == "TTAA");
    assert(bio_index::close(reopened) == 0);
    let response = bio_http::request("GET", "@LOOPBACK@/ok");
    assert(response.status == 200 && response.body == "hello" && response.error.len == 0);
    assert(bio_http::request("GET", "@LOOPBACK@/missing").status == 404);
    assert(bio_http::request("GET", "@LOOPBACK@/ok", "", 1000, 2).code != 0);
    let http = bio_http::native_start("GET", "@LOOPBACK@/ok", "", 1000, 100, 1000);
    assert(http > 0 && bio_http::native_close(http) == 0);
    assert(bio_http::native_close(http) == -1);
    print("optional relocated semantics passed");
}
